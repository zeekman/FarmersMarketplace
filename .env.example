# ── Stellar / Soroban ─────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Escrow contract (actively developed crate: contracts/escrow)
ESCROW_CONTRACT_ID=

# Creator earnings contract (contracts/creator-earnings)
CREATOR_EARNINGS_CONTRACT_ID=

# Legacy escrow contract (contract/) — DEPRECATED, see docs/adr/0002-contract-architecture.md
# Only set these if you still need to interact with a previously deployed legacy instance.
# Legacy ABI calls are disabled by default; enable only for compatibility work.
ENABLE_LEGACY_ESCROW_ABI=false
LEGACY_ESCROW_CONTRACT_ID=
