{
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:import/recommended"
  ],
  "plugins": ["react", "react-hooks", "react-refresh", "i18next", "import", "jsx-a11y"],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "no-redeclare": ["error"],
    "import/first": ["error"],
    "import/no-duplicates": ["error"],
    "react-refresh/only-export-components": ["warn", { "allowConstantExport": true }],
    "jsx-a11y/alt-text": "error",
    "import/no-unused-modules": ["error", { "unusedExports": true }],
    "i18next/no-literal-string": [
      "warn",
      {
        "mode": "jsx-text-only",
        "should-validate-template": false,
        "ignore": ["XLM", "kg", "g", "lb", "oz", "unit", "units", "+", "-", "×", "÷", "=", "/", ":", ";", ",", ".", "!", "?", "%", "$", "#", "@", "&", "|", "\\", "(", ")", "[", "]", "{", "}", "<", ">", "~", "`", "^", "*", "_"]
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "JSXAttribute[name.name='style'] ObjectExpression Property[key.name=/^(marginLeft|marginRight|paddingLeft|paddingRight|left|right)$/]",
        "message": "Use logical properties (marginInlineStart/End, paddingInlineStart/End, insetInlineStart/End) instead of physical properties for RTL support"
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "localStorage",
        "message": "Use safeStorage from utils/safeStorage.js to handle SecurityError and QuotaExceededError"
      },
      {
        "name": "sessionStorage",
        "message": "Use safeSessionStorage from utils/safeStorage.js to handle SecurityError and QuotaExceededError"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/pages/ProductDetail.jsx", "src/pages/Settings.jsx", "src/pages/Auth.jsx", "src/pages/AdminDashboard.jsx"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "JSXAttribute[name.name='style'] ObjectExpression Property[key.name=/^(marginLeft|marginRight|paddingLeft|paddingRight|left|right)$/]",
            "message": "Use logical properties (marginInlineStart/End, paddingInlineStart/End, insetInlineStart/End) instead of physical properties for RTL support"
          },
          {
            "selector": "Property > Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
            "message": "Use a theme token (var(--color-*) from styles/tokens.css) instead of a hex colour so dark mode works"
          }
        ]
      }
    },
    {
      "files": ["src/pages/**/*.jsx", "src/components/**/*.jsx"],
      "rules": {
        "i18next/no-literal-string": [
          "warn",
          {
            "mode": "jsx-text-only",
            "should-validate-template": false,
            "ignore": ["XLM", "kg", "g", "lb", "oz", "unit", "units"]
          }
        ]
      }
    },
    {
      "files": ["src/utils/safeStorage.js", "src/utils/marketplaceSnapshot.js"],
      "rules": {
        "no-restricted-globals": "off"
      }
    }
  ],
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  }
}
