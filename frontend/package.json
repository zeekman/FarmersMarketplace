{
  "name": "farmers-marketplace-frontend",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run check:bundle-size && echo Bundle report: dist/bundle-report.html",
    "preview": "vite preview",
    "test": "vitest run",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "i18n:check": "node scripts/check-i18n.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-path ../.prettierignore"
  },
  "devDependencies_note": "run: npm install --save-dev rollup-plugin-visualizer --legacy-peer-deps",
  "dependencies": {
    "@stellar/freighter-api": "6.0.1",
    "@tanstack/react-query": "^5.59.0",
    "dompurify": "^3.3.3",
    "i18next": "^26.0.1",
    "leaflet": "^1.9.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^17.0.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@playwright/test": "^1.44.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.6",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-plugin-i18next": "^6.0.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^24.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^6.2.0",
    "vitest": "^3.1.0",
    "wait-on": "^7.2.0"
  }
